# ═══════════════════════════════════════════════════════════════
# HVNA PRESALE LANDING PAGE - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# Resend API Key (for sending emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 Measurement ID (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Base Network RPC URL (optional - uses public RPC by default)
# You can use Alchemy, Infura, or QuickNode for better reliability
BASE_RPC_URL=https://mainnet.base.org

# Database Configuration (if using)
# Uncomment and configure if you're using a database like Supabase or PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/database
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# CORS Configuration (if needed for API)
# ALLOWED_ORIGINS=https://presale.havanaelephant.com,https://www.havanaelephant.com

# Feature Flags (optional)
# ENABLE_EMAIL_COLLECTION=true
# ENABLE_EXIT_INTENT=true
# TEST_MODE=false

# ─────────────────────────────────────────────────────────────
# Didit KYC Configuration
# ─────────────────────────────────────────────────────────────

# SECRET — set ONLY in Vercel dashboard or via Terminal (`vercel env add DIDIT_API_KEY`).
# Never commit the real value to git.
DIDIT_API_KEY=

# Identifies the Didit verification workflow (not a secret — safe to expose).
DIDIT_WORKFLOW_ID=6be07ae2-322e-40fb-bf4a-82d6c247c803
